<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:paddingTop="12dp"
    android:paddingBottom="28dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_drag_handle" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="18dp"
        android:paddingEnd="24dp"
        android:fontFamily="sans-serif-medium"
        android:text="@string/net_balance_trend"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <com.abk.brodue.NetGraphView
        android:id="@+id/netGraph"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginTop="14dp" />

    <TextView
        android:id="@+id/tvDays"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginEnd="24dp"
        android:layout_marginStart="24dp"
        android:fontFamily="sans-serif-medium"
        android:paddingTop="2dp"
        android:paddingBottom="4dp"
        android:textColor="@color/grey_soft"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvGraphEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:gravity="center"
        android:paddingTop="48dp"
        android:paddingBottom="48dp"
        android:text="@string/not_enough_to_plot"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:visibility="gone" />
</LinearLayout>