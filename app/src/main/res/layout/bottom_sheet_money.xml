<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="12dp"
    android:paddingEnd="24dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_drag_handle" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <TextView
                android:id="@+id/tvMoneyTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="sans-serif"
                android:text="@string/receive"
                android:textColor="@color/navy_text"
                android:textSize="17sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/amountBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_field"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="10dp"
                android:paddingEnd="16dp"
                android:paddingBottom="10dp">

                <TextView
                    android:id="@+id/tvCurrencySymbol"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:textColor="@color/grey_soft"
                    android:textSize="60sp"
                    tools:text="₹" />

                <EditText
                    android:id="@+id/etAmount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:digits="0123456789."
                    android:fontFamily="sans-serif-medium"
                    android:inputType="numberDecimal"
                    android:paddingStart="10dp"
                    android:paddingEnd="0dp"
                    android:textColor="@color/navy_text"
                    android:textSize="75sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/dateBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_field"
                    android:gravity="center_vertical"
                    android:minHeight="48dp"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingTop="13dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="13dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@string/date_label"
                        android:src="@drawable/ic_calendar" />

                    <TextView
                        android:id="@+id/tvDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/today"
                        android:textColor="@color/navy_text"
                        android:textSize="15sp" />
                </LinearLayout>

                <Space
                    android:layout_width="12dp"
                    android:layout_height="1dp" />

                <LinearLayout
                    android:id="@+id/timeBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_field"
                    android:gravity="center_vertical"
                    android:minHeight="48dp"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingTop="13dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="13dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@string/now"
                        android:src="@drawable/ic_clock" />

                    <TextView
                        android:id="@+id/tvTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/now"
                        android:textColor="@color/navy_text"
                        android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/category_label"
                android:textColor="@color/grey_soft"
                android:textSize="12sp" />

            <com.abk.brodue.FlowLayout
                android:id="@+id/categoryFlow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chipOnline"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:fontFamily="sans-serif-medium"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    android:stateListAnimator="@animator/btn_press_scale"
                    android:text="@string/online"
                    android:textColor="@color/grey_soft"
                    android:textSize="14sp"
                    app:backgroundTint="@color/field_bg"
                    app:cornerRadius="50dp"
                    app:elevation="0dp"
                    app:icon="@drawable/ic_custom_01"
                    app:iconPadding="6dp"
                    app:iconSize="15dp"
                    app:iconTint="@color/grey_soft"
                    app:strokeColor="@color/border_light"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chipRecharge"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:fontFamily="sans-serif-medium"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    android:stateListAnimator="@animator/btn_press_scale"
                    android:text="@string/recharge"
                    android:textColor="@color/grey_soft"
                    android:textSize="14sp"
                    app:backgroundTint="@color/field_bg"
                    app:cornerRadius="50dp"
                    app:elevation="0dp"
                    app:icon="@drawable/ic_custom_02"
                    app:iconPadding="6dp"
                    app:iconSize="15dp"
                    app:iconTint="@color/grey_soft"
                    app:strokeColor="@color/border_light"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chipCash"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:fontFamily="sans-serif-medium"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    android:stateListAnimator="@animator/btn_press_scale"
                    android:text="@string/cash"
                    android:textColor="@color/grey_soft"
                    android:textSize="14sp"
                    app:backgroundTint="@color/field_bg"
                    app:cornerRadius="50dp"
                    app:elevation="0dp"
                    app:icon="@drawable/ic_custom_03"
                    app:iconPadding="6dp"
                    app:iconSize="15dp"
                    app:iconTint="@color/grey_soft"
                    app:strokeColor="@color/border_light"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chipItem"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:fontFamily="sans-serif-medium"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    android:stateListAnimator="@animator/btn_press_scale"
                    android:text="@string/item"
                    android:textColor="@color/grey_soft"
                    android:textSize="14sp"
                    app:backgroundTint="@color/field_bg"
                    app:cornerRadius="50dp"
                    app:elevation="0dp"
                    app:icon="@drawable/ic_custom_04"
                    app:iconPadding="6dp"
                    app:iconSize="15dp"
                    app:iconTint="@color/grey_soft"
                    app:strokeColor="@color/border_light"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chipRoundoff"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:fontFamily="sans-serif-medium"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    android:stateListAnimator="@animator/btn_press_scale"
                    android:text="@string/roundoff"
                    android:textColor="@color/grey_soft"
                    android:textSize="14sp"
                    app:backgroundTint="@color/field_bg"
                    app:cornerRadius="50dp"
                    app:elevation="0dp"
                    app:icon="@drawable/ic_custom_27"
                    app:iconPadding="6dp"
                    app:iconSize="15dp"
                    app:iconTint="@color/grey_soft"
                    app:strokeColor="@color/border_light"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chipAdd"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:contentDescription="Add custom category"
                    android:stateListAnimator="@animator/btn_press_scale"
                    app:backgroundTint="@color/field_bg"
                    app:cornerRadius="22dp"
                    app:elevation="0dp"
                    app:icon="@drawable/ic_add_category"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="15dp"
                    app:iconTint="@color/grey_soft"
                    app:strokeColor="@color/border_light"
                    app:strokeWidth="1dp" />
            </com.abk.brodue.FlowLayout>

            <EditText
                android:id="@+id/etNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_field_selector"
                android:fontFamily="sans-serif"
                android:hint="@string/note"
                android:inputType="textCapSentences"
                android:paddingStart="14dp"
                android:paddingTop="14dp"
                android:paddingEnd="14dp"
                android:paddingBottom="14dp"
                android:textColor="@color/navy_text"
                android:textColorHint="@color/grey_soft"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_weight="1">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSaveMoney"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:stateListAnimator="@animator/btn_press_scale"
                        android:text="@string/receive"
                        android:textColor="@color/save_green"
                        android:textSize="15sp"
                        app:backgroundTint="@color/save_green_soft"
                        app:cornerRadius="14dp"
                        app:elevation="0dp" />

                    <ImageView
                        android:id="@+id/imgSavePlus"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="start|center_vertical"
                        android:layout_marginStart="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_plus"
                        app:tint="@color/save_green" />
                </FrameLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDeleteMoney"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="12dp"
                    android:contentDescription="@string/deleted"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:paddingLeft="0dp"
                    android:paddingRight="0dp"
                    android:stateListAnimator="@animator/btn_press_scale"
                    android:visibility="gone"
                    app:backgroundTint="@color/save_red_soft"
                    app:cornerRadius="26dp"
                    app:elevation="0dp"
                    app:icon="@drawable/ic_trash"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="22dp"
                    app:iconTint="@color/save_red" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvSavedAt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:textColor="@color/grey_soft"
                android:textSize="12sp"
                android:visibility="gone" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
