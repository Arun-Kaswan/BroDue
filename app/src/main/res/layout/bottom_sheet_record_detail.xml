<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="12dp"
    android:paddingEnd="24dp"
    android:paddingBottom="20dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_drag_handle" />

    <FrameLayout
        android:id="@+id/rdPersonRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/rdPersonAvatar"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@drawable/bg_circle"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:textColor="@color/letter_1"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="A" />

            <TextView
                android:id="@+id/rdPersonName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/navy_text"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:text="Aman Kumar" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnRdInfo"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="end|center_vertical"
            android:contentDescription="Info"
            android:padding="4dp"
            android:src="@drawable/ic_info"
            android:visibility="gone"
            app:tint="@color/grey_soft"
            tools:visibility="visible" />
    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp">

        <TextView
            android:id="@+id/rdTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="sans-serif"
            android:text="@string/receive"
            android:textColor="@color/navy_text"
            android:textSize="17sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnRdInfoTitle"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="end|center_vertical"
            android:contentDescription="Info"
            android:padding="4dp"
            android:src="@drawable/ic_info"
            android:visibility="gone"
            app:tint="@color/grey_soft"
            tools:visibility="visible" />
    </FrameLayout>

    <TextView
        android:id="@+id/rdAmount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:letterSpacing="0.05"
        android:paddingTop="8dp"
        android:paddingBottom="16dp"
        android:textColor="@color/save_green"
        android:textSize="40sp"
        android:textStyle="bold"
        tools:text="+₹500" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:text="@string/category_label"
        android:textColor="@color/grey_soft"
        android:textSize="12sp" />

    <com.abk.brodue.FlowLayout
        android:id="@+id/rdCategoryFlow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/chipRdOnline"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:clickable="false"
            android:focusable="false"
            android:fontFamily="sans-serif-medium"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:stateListAnimator="@null"
            android:text="@string/online"
            android:textColor="@color/grey_soft"
            android:textSize="14sp"
            app:backgroundTint="@color/field_bg"
            app:cornerRadius="50dp"
            app:elevation="0dp"
            app:icon="@drawable/ic_custom_01"
            app:iconPadding="6dp"
            app:iconSize="15dp"
            app:iconTint="@color/grey_soft"
            app:rippleColor="@android:color/transparent"
            app:strokeColor="@color/border_light"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/chipRdRecharge"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:clickable="false"
            android:focusable="false"
            android:fontFamily="sans-serif-medium"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:stateListAnimator="@null"
            android:text="@string/recharge"
            android:textColor="@color/grey_soft"
            android:textSize="14sp"
            app:backgroundTint="@color/field_bg"
            app:cornerRadius="50dp"
            app:elevation="0dp"
            app:icon="@drawable/ic_custom_02"
            app:iconPadding="6dp"
            app:iconSize="15dp"
            app:iconTint="@color/grey_soft"
            app:rippleColor="@android:color/transparent"
            app:strokeColor="@color/border_light"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/chipRdCash"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:clickable="false"
            android:focusable="false"
            android:fontFamily="sans-serif-medium"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:stateListAnimator="@null"
            android:text="@string/cash"
            android:textColor="@color/grey_soft"
            android:textSize="14sp"
            app:backgroundTint="@color/field_bg"
            app:cornerRadius="50dp"
            app:elevation="0dp"
            app:icon="@drawable/ic_custom_03"
            app:iconPadding="6dp"
            app:iconSize="15dp"
            app:iconTint="@color/grey_soft"
            app:rippleColor="@android:color/transparent"
            app:strokeColor="@color/border_light"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/chipRdItem"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:clickable="false"
            android:focusable="false"
            android:fontFamily="sans-serif-medium"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:stateListAnimator="@null"
            android:text="@string/item"
            android:textColor="@color/grey_soft"
            android:textSize="14sp"
            app:backgroundTint="@color/field_bg"
            app:cornerRadius="50dp"
            app:elevation="0dp"
            app:icon="@drawable/ic_custom_04"
            app:iconPadding="6dp"
            app:iconSize="15dp"
            app:iconTint="@color/grey_soft"
            app:rippleColor="@android:color/transparent"
            app:strokeColor="@color/border_light"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/chipRdRoundoff"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:clickable="false"
            android:focusable="false"
            android:fontFamily="sans-serif-medium"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:stateListAnimator="@null"
            android:text="@string/roundoff"
            android:textColor="@color/grey_soft"
            android:textSize="14sp"
            app:backgroundTint="@color/field_bg"
            app:cornerRadius="50dp"
            app:elevation="0dp"
            app:icon="@drawable/ic_custom_27"
            app:iconPadding="6dp"
            app:iconSize="15dp"
            app:iconTint="@color/grey_soft"
            app:rippleColor="@android:color/transparent"
            app:strokeColor="@color/border_light"
            app:strokeWidth="1dp" />
    </com.abk.brodue.FlowLayout>

    <LinearLayout
        android:id="@+id/rdNoteGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/note"
            android:textColor="@color/grey_soft"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/rdNoteBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_field"
            android:fontFamily="sans-serif-medium"
            android:minHeight="48dp"
            android:paddingStart="14dp"
            android:paddingTop="13dp"
            android:paddingEnd="14dp"
            android:paddingBottom="13dp"
            android:textColor="@color/navy_text"
            android:textSize="15sp"
            tools:text="Dinner at cafe" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/time_label"
            android:textColor="@color/grey_soft"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_field"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="13dp"
                android:paddingEnd="14dp"
                android:paddingBottom="13dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@string/date_label"
                    android:src="@drawable/ic_calendar" />

                <TextView
                    android:id="@+id/tvRdDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/navy_text"
                    android:textSize="15sp"
                    tools:text="12 Aug 2026" />
            </LinearLayout>

        <Space
            android:layout_width="12dp"
            android:layout_height="1dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_field"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="13dp"
            android:paddingEnd="14dp"
            android:paddingBottom="13dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@string/time_label"
                android:src="@drawable/ic_clock" />

            <TextView
                android:id="@+id/tvRdTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/navy_text"
                android:textSize="15sp"
                tools:text="3:45 PM" />
        </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rdCreatorRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone"
        tools:visibility="visible">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/rdCreatorImg"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/CircleImage" />

        <TextView
            android:id="@+id/rdCreatedBy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:alpha="0.7"
            android:fontFamily="sans-serif"
            android:textColor="@color/grey_soft"
            android:textSize="11.5sp"
            tools:text="Aman Kumar" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEditRecord"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="sans-serif-medium"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:paddingTop="13dp"
        android:paddingBottom="13dp"
        android:stateListAnimator="@animator/btn_press_scale"
        android:text="@string/edit"
        android:textColor="@color/white"
        android:textSize="15sp"
        app:backgroundTint="@color/accent_purple"
        app:cornerRadius="14dp"
        app:elevation="0dp"
        app:icon="@drawable/ic_pencil"
        app:iconGravity="textStart"
        app:iconPadding="8dp"
        app:iconSize="20dp"
        app:iconTint="@color/white" />

</LinearLayout>
