<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="12dp"
    android:paddingEnd="24dp"
    android:paddingBottom="32dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_drag_handle" />

    <FrameLayout
        android:id="@+id/shareHeaderRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">

        <TextView
            android:id="@+id/shareCodeTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="sans-serif-medium"
            android:text="@string/sharing_code"
            android:textColor="@color/navy_text"
            android:textSize="17sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnQr"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="end|center_vertical"
            android:contentDescription="@string/scan_to_join"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:stateListAnimator="@animator/btn_press_scale"
            app:backgroundTint="@android:color/transparent"
            app:cornerRadius="20dp"
            app:icon="@drawable/ic_qr"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="24dp"
            app:iconTint="@color/text_primary"
            app:rippleColor="@color/primary_container" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/codeRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/codeChar0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_field"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:minHeight="58dp"
            android:textColor="@color/navy_text"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:text="A" />

        <Space
            android:layout_width="6dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/codeChar1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_field"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:minHeight="58dp"
            android:textColor="@color/navy_text"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:text="B" />

        <Space
            android:layout_width="6dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/codeChar2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_field"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:minHeight="58dp"
            android:textColor="@color/navy_text"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:text="C" />

        <Space
            android:layout_width="6dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/codeChar3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_field"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:minHeight="58dp"
            android:textColor="@color/navy_text"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:text="D" />

        <Space
            android:layout_width="6dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/codeChar4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_field"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:minHeight="58dp"
            android:textColor="@color/navy_text"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:text="E" />

        <Space
            android:layout_width="6dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/codeChar5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_field"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:minHeight="58dp"
            android:textColor="@color/navy_text"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:text="F" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/codeButtonsRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDisableCode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingTop="13dp"
            android:paddingBottom="13dp"
            android:stateListAnimator="@animator/btn_press_scale"
            android:text="@string/disable_code"
            android:textColor="@color/negative"
            android:textSize="14sp"
            app:backgroundTint="@color/field_bg"
            app:cornerRadius="14dp"
            app:elevation="0dp"
            app:strokeColor="@color/border_light"
            app:strokeWidth="1dp" />

        <Space
            android:layout_width="12dp"
            android:layout_height="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNewCode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingTop="13dp"
            android:paddingBottom="13dp"
            android:stateListAnimator="@animator/btn_press_scale"
            android:text="@string/create_new_code"
            android:textColor="@color/white"
            android:textSize="14sp"
            app:backgroundTint="@color/primary"
            app:cornerRadius="14dp"
            app:elevation="0dp" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnShareCode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="sans-serif-medium"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:paddingTop="13dp"
        android:paddingBottom="13dp"
        android:stateListAnimator="@animator/btn_press_scale"
        android:text="@string/share_code"
        android:textColor="@color/navy_text"
        android:textSize="14sp"
        app:backgroundTint="@color/field_bg"
        app:cornerRadius="14dp"
        app:elevation="0dp"
        app:icon="@drawable/ic_share_new"
        app:iconGravity="textStart"
        app:iconPadding="8dp"
        app:iconSize="20dp"
        app:iconTint="@color/navy_text"
        app:strokeColor="@color/border_light"
        app:strokeWidth="1dp" />

    <LinearLayout
        android:id="@+id/shareAsMeCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_field"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="42dp"
            android:layout_height="42dp"
            app:cardBackgroundColor="#265B6BA3"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:scaleType="fitCenter"
                app:srcCompat="@drawable/ic_share_me"
                app:tint="@color/primary" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/share_as_me"
                android:textColor="@color/navy_text"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:alpha="0.6"
                android:fontFamily="sans-serif"
                android:text="@string/share_as_me_sub"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <com.abk.brodue.IosSwitch
            android:id="@+id/switchShareAsMe2"
            android:layout_width="44dp"
            android:layout_height="26dp"
            android:layout_marginStart="12dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/membersTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="sans-serif-medium"
        android:text="@string/members"
        android:textColor="@color/grey_soft"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/membersList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLeave"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="sans-serif-medium"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:paddingTop="13dp"
        android:paddingBottom="13dp"
        android:stateListAnimator="@animator/btn_press_scale"
        android:text="@string/leave"
        android:textColor="@color/negative"
        android:textSize="14sp"
        android:visibility="gone"
        app:backgroundTint="@color/field_bg"
        app:cornerRadius="14dp"
        app:elevation="0dp"
        app:strokeColor="@color/border_light"
        app:strokeWidth="1dp"
        tools:visibility="visible" />

</LinearLayout>
