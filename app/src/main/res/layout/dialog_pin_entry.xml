<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/pinTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/navy_text"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/pinHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:alpha="0.7"
        android:fontFamily="sans-serif"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/pinInput"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:alpha="0"
        android:importantForAccessibility="no"
        android:imeOptions="actionDone"
        android:inputType="number"
        android:maxLength="6" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/pinBox0"
            android:layout_width="44dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_field"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:textColor="@color/navy_text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/pinBox1"
            android:layout_width="44dp"
            android:layout_height="52dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_field"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:textColor="@color/navy_text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/pinBox2"
            android:layout_width="44dp"
            android:layout_height="52dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_field"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:textColor="@color/navy_text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/pinBox3"
            android:layout_width="44dp"
            android:layout_height="52dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_field"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:textColor="@color/navy_text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/pinBox4"
            android:layout_width="44dp"
            android:layout_height="52dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_field"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:textColor="@color/navy_text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/pinBox5"
            android:layout_width="44dp"
            android:layout_height="52dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_field"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:textColor="@color/navy_text"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/pinError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:textColor="@color/negative"
        android:textSize="12sp"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPinNext"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="20dp"
        android:enabled="false"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="Next"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="15sp"
        app:backgroundTint="@color/btn_confirm_bg"
        app:cornerRadius="14dp" />

</LinearLayout>
