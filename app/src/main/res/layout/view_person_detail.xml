<?xml version="1.0" encoding="utf-8"?>
<com.abk.brodue.SwipeCloseLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:visibility="gone">

    <LinearLayout
        android:id="@+id/detailHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="6dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDetailBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/back"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:stateListAnimator="@animator/btn_press_scale"
            app:backgroundTint="@android:color/transparent"
            app:cornerRadius="20dp"
            app:icon="@drawable/ic_chevron_left"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="24dp"
            app:iconTint="@color/text_primary"
            app:rippleColor="@color/primary_container" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="30dp"
                android:layout_height="30dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/detailAvatarPhoto"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    app:shapeAppearanceOverlay="@style/CircleImage" />

                <TextView
                    android:id="@+id/detailAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_circle"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:textColor="@color/letter_1"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="A" />
            </FrameLayout>

            <TextView
                android:id="@+id/detailName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:text="Aman Kumar" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDetailSync"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/sync"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:stateListAnimator="@animator/btn_press_scale"
            app:backgroundTint="@android:color/transparent"
            app:cornerRadius="20dp"
            app:icon="@drawable/ic_sync_off"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="24dp"
            app:iconTint="@color/text_primary"
            app:rippleColor="@color/primary_container" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDetailInfo"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/info"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:stateListAnimator="@animator/btn_press_scale"
            app:backgroundTint="@android:color/transparent"
            app:cornerRadius="20dp"
            app:icon="@drawable/ic_info"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="24dp"
            app:iconTint="@color/text_primary"
            app:rippleColor="@color/primary_container" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/netCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:stateListAnimator="@animator/btn_press_scale"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/card_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="24dp"
                android:paddingEnd="18dp"
                android:paddingBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.08"
                    android:text="@string/net_balance"
                    android:textAllCaps="true"
                    android:textColor="#8A93A3"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvNetAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/text_primary"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        tools:text="₹1,200" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

    <LinearLayout
        android:id="@+id/leftGroupRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/tvLeftGroupPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_field"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:text="@string/left_group"
            android:textColor="@color/grey_soft"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/syncPausedRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_paused"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:text="@string/sync_paused"
            android:textColor="@color/save_red"
            android:textSize="11sp" />
    </LinearLayout>

        <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvRecords"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="88dp"
            tools:listitem="@layout/item_transaction" />

        <LinearLayout
            android:id="@+id/recordsEmpty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="36dp"
            android:paddingBottom="36dp">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_circle_grey"
                android:contentDescription="@string/no_records"
                android:padding="16dp"
                app:srcCompat="@drawable/ic_pencil" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/no_records"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/detailBottomBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center"
            android:layout_marginBottom="16dp"
            android:clickable="true"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:elevation="8dp"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="12dp">

            <FrameLayout
                android:id="@+id/wrapReceived"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:layout_marginEnd="-12dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReceived"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/received_money"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:stateListAnimator="@animator/btn_press_scale"
                    app:backgroundTint="@color/positive_container"
                    app:cornerRadius="30dp"
                    app:elevation="3dp"
                    app:icon="@drawable/ic_arrow_down"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="26dp"
                    app:iconTint="@color/positive"
                    app:strokeColor="@color/positive_border"
                    app:strokeWidth="0.5dp" />
            </FrameLayout>

            <Space
                android:layout_width="14dp"
                android:layout_height="1dp" />

            <FrameLayout
                android:id="@+id/wrapGave"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:layout_marginStart="-12dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGave"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/gave_money"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:stateListAnimator="@animator/btn_press_scale"
                    app:backgroundTint="@color/negative_container"
                    app:cornerRadius="30dp"
                    app:elevation="3dp"
                    app:icon="@drawable/ic_arrow_up"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="26dp"
                    app:iconTint="@color/negative"
                    app:strokeColor="@color/negative_border"
                    app:strokeWidth="0.5dp" />
            </FrameLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditCopy"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:minWidth="160dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:stateListAnimator="@animator/btn_press_scale"
                android:text="@string/edit"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:visibility="gone"
                app:backgroundTint="@color/primary"
                app:cornerRadius="28dp"
                app:elevation="3dp"
                app:icon="@drawable/ic_pencil"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconSize="18dp"
                app:iconTint="@color/white"
                tools:visibility="visible" />
        </LinearLayout>
    </FrameLayout>

</com.abk.brodue.SwipeCloseLayout>